FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      ffmpeg \
      fonts-dejavu-core \
      fonts-freefont-ttf \
      fonts-liberation \
      fonts-noto-cjk \
      fonts-noto-color-emoji \
      fonts-noto-core \
      fonts-noto-extra \
      fonts-noto-ui-core \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libc6 \
      libcairo2 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libfontconfig1 \
      libfreetype6 \
      libgbm1 \
      libglib2.0-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libxcomposite1 \
      libxdamage1 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
      libxshmfence1 \
      tini \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global @puppeteer/browsers@2.13.0 \
    && npx @puppeteer/browsers install chrome-headless-shell@152.0.7977.30 \
      --path /opt/chrome \
    && npm uninstall --global @puppeteer/browsers \
    && rm -rf /root/.npm

RUN npm install --global bun@1.4.4

ENV PATH="/root/.bun/bin:$PATH"
ENV PRODUCER_HEADLESS_SHELL_PATH=/opt/chrome/chrome-headless-shell/linux-152.0.7977.30/chrome-headless-shell-linux64/chrome-headless-shell
ENV HYPERFRAMES_CHROME_PATH=/opt/chrome/chrome-headless-shell/linux-152.0.7977.30/chrome-headless-shell-linux64/chrome-headless-shell
ENV CONTAINER=true
ENV VITE_HYPERFRAMES_RENDER_PROFILE=4k60
ENV NODE_ENV=development

WORKDIR /workspace
COPY . .
RUN bun install --frozen-lockfile || bun install --frozen-lockfile
RUN bun run --filter '@hyperframes/{parsers,lint,studio-server}' build \
    && bun run --filter @hyperframes/core build

WORKDIR /workspace/packages/studio
EXPOSE 5190
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bun", "--bun", "./node_modules/.bin/vite", "--host", "0.0.0.0", "--port", "5190", "--strictPort"]
